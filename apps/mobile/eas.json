{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://reworth-y9gr.onrender.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://YOUR-WEBSITE.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://reworth-y9gr.onrender.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://YOUR-WEBSITE.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
