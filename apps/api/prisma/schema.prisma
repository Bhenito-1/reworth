// ReWorth API — Phase 1–10 MVP + Phase 2.1 Swap / Give-Away

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationLevel {
  L1_PHONE
  L2_EMAIL
  L3_IDENTITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum IdentityMethod {
  NIN
  BVN
  GOV_ID
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  CUSTOMER_SUPPORT
  RISK_FRAUD
  FINANCE
  MARKETING
  CONTENT_MODERATOR
}

enum MovingSaleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CommunityType {
  ESTATE
  CORPORATE
  CHURCH
  ALUMNI
  PUBLIC
}

enum CommunityPrivacy {
  PUBLIC
  SEMI_PRIVATE
  PRIVATE
}

enum CommunityMembershipStatus {
  INVITED
  APPROVED
  MEMBER
  SUSPENDED
  LEFT
}

enum ListingStatus {
  DRAFT
  UNDER_REVIEW
  LIVE
  RESERVED
  SOLD
  EXPIRED
  REMOVED
  REJECTED
}

enum SellingMode {
  SELL
  SWAP
  GIVE_AWAY
}

enum ItemCondition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  FAIR
  FOR_PARTS
}

enum ListingEventType {
  VIEWED
  SAVED
  PRICE_CHANGED
  STATUS_CHANGED
}

enum ListingImageStatus {
  PENDING
  READY
  FAILED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportAction {
  WARN
  REMOVE_LISTING
  SUSPEND_USER
}

enum MessageType {
  TEXT
  IMAGE
  LISTING_CARD
  OFFER_CARD
  SWAP_PROPOSAL_CARD
  GIVEAWAY_CLAIM
  SYSTEM
}

enum SwapProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
  COMPLETED
  CANCELLED
  EXPIRED
}

enum GiveawayClaimStatus {
  CLAIMED
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

enum TransactionType {
  CASH
  SWAP
  GIVEAWAY
}

enum SwapLegStatus {
  PENDING
  HANDED_OVER
  RECEIVED
  FAILED
  RETURNED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
  EXPIRED
}

enum OrderIntentStatus {
  PENDING
  CONVERTED
  CANCELLED
  EXPIRED
}

/// Seller must confirm a cash order before the buyer can pay.
enum OrderConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ChatScanKind {
  OFF_PLATFORM_PAYMENT
  EXTERNAL_LINK
  ADVANCE_PAYMENT
  SCAM_PHRASE
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  FUNDED
  IN_AUTHENTICATION
  /// Courier/seller has dispatched the item (delivery) or equivalent in transit.
  SHIPPED
  /// Meet/pickup handover completed (item with buyer physically).
  HANDED_OVER
  /// Courier marked delivered — awaiting buyer confirmation (escrow still held).
  DELIVERED
  /// Buyer confirmed receipt — escrow release triggered.
  RECEIVED
  /// Escrow released to seller; order finished.
  COMPLETED
  CANCELLED
  DISPUTE_HOLD
  REFUND_REQUESTED
  REFUND_ISSUED
}

enum InspectionStatus {
  REQUESTED
  PAYMENT_PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum AuthenticationStatus {
  NOT_REQUIRED
  REQUIRED
  PENDING
  PASSED
  FAILED
  OPTED_OUT
}

enum LuxuryAuthJobStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  CANCELLED
}

enum ProAccountStatus {
  APPLIED
  APPROVED
  ACTIVE
  GRACE
  SUSPENDED
  REJECTED
}

enum BulkUploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReferralRewardStatus {
  PENDING
  GRANTED
  BLOCKED
  FLAGGED
}

enum AssistantMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum RoomScanStatus {
  UPLOADED
  DETECTING
  READY
  DRAFTS_CREATED
  FAILED
  CANCELLED
}

enum ConsignmentStatus {
  INTAKE
  LISTED
  SOLD
  RETURNED
  EXPIRED
  CANCELLED
}

enum ManagedPickupStatus {
  BOOKED
  ASSIGNED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CorporateAccountStatus {
  APPLIED
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RelocationProjectStatus {
  DRAFT
  INTAKE
  LISTED
  IN_FULFILMENT
  COMPLETING
  COMPLETED
  CANCELLED
}

enum EstatePartnerStatus {
  APPLIED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CircularPartnerKind {
  CHARITY
  RECYCLER
}

enum CircularHandoffStatus {
  SCHEDULED
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum FulfilmentMethod {
  PICKUP
  MEET_POINT
  DELIVERY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  RELEASED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DisputeStatus {
  OPENED
  AWAITING_SELLER
  AWAITING_ADMIN
  RESOLVED
}

enum DisputeReason {
  NEVER_RECEIVED
  MATERIALLY_DIFFERENT
  COUNTERFEIT
  UNDISCLOSED_DAMAGE
  INCORRECT_PRODUCT
}

enum DisputeResolution {
  FULL_REFUND
  PARTIAL_REFUND
  RELEASE_TO_SELLER
  CANCEL
}

enum DeliveryShipmentStatus {
  QUOTED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ModerationOutcome {
  PASS
  UNDER_REVIEW
  REJECTED
}

enum AppealStatus {
  OPEN
  APPROVED
  DENIED
}

enum ConsentChannel {
  MARKETING
  EMAIL
}

enum PromotionKind {
  FEATURED
  BOOST
  PROMOTED
}

enum ReviewStatus {
  PENDING_MUTUAL
  PUBLISHED
  HIDDEN
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  phone           String?    @unique
  phoneVerifiedAt DateTime?
  email           String?    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  status          UserStatus @default(ACTIVE)
  riskLevel       RiskLevel  @default(LOW)
  riskScore       Int        @default(0)
  enhancedVerificationRequired Boolean @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  profile              Profile?
  addresses            Address[]
  verifications        Verification[]
  devices              Device[]
  refreshTokens        RefreshToken[]
  roles                UserRole[]
  auditLogs            AuditLog[]           @relation("AuditActor")
  listings             Listing[]
  listingEvents        ListingEvent[]       @relation("ListingEventActor")
  riskEvents           RiskEvent[]
  reports              Report[]             @relation("ReportReporter")
  reportsAgainst       Report[]             @relation("ReportReportedUser")
  reportsResolved      Report[]             @relation("ReportResolver")
  favourites           Favourite[]
  cartItems            CartItem[]
  savedSearches        SavedSearch[]
  following            SellerFollow[]       @relation("SellerFollowers")
  followers            SellerFollow[]       @relation("SellerFollowing")
  conversationsAsBuyer Conversation[]       @relation("ConversationBuyer")
  conversationsAsSeller Conversation[]      @relation("ConversationSeller")
  messagesSent         Message[]            @relation("MessageSender")
  offersAsBuyer        Offer[]              @relation("OfferBuyer")
  offersAsSeller       Offer[]              @relation("OfferSeller")
  offerEvents          OfferEvent[]         @relation("OfferEventActor")
  orderIntentsAsBuyer  OrderIntent[]        @relation("OrderIntentBuyer")
  orderIntentsAsSeller OrderIntent[]        @relation("OrderIntentSeller")
  blocksCreated        UserBlock[]          @relation("UserBlocker")
  blocksReceived       UserBlock[]          @relation("UserBlocked")
  mutesCreated         UserMute[]           @relation("UserMuter")
  mutesReceived        UserMute[]           @relation("UserMuted")
  ordersAsBuyer        Order[]              @relation("OrderBuyer")
  paymentsMade         Payment[]            @relation("PaymentPayer")
  ordersAsSeller       Order[]              @relation("OrderSeller")
  orderEvents          OrderEvent[]         @relation("OrderEventActor")
  disputesOpened       Dispute[]            @relation("DisputeOpener")
  disputeEvidence      DisputeEvidence[]
  notifications        Notification[]
  adminAlerts          AdminAlert[]
  notificationPrefs    NotificationPreference[]
  devicePushTokens     DevicePushToken[]
  supportTickets       SupportTicket[]
  addressDisclosures   AddressDisclosure[]  @relation("AddressDiscloser")
  reviewsGiven         Review[]             @relation("ReviewReviewer")
  reviewsReceived      Review[]             @relation("ReviewReviewee")
  reviewReports        ReviewReport[]       @relation("ReviewReporter")
  trustScore           TrustScore?
  trustScoreHistory    TrustScoreHistory[]
  chatResponseSamples  ChatResponseSample[] @relation("ChatResponseSeller")
  adminTotp            AdminTotp?
  promotionsCreated    Promotion[]          @relation("PromotionCreator")
  sellerSubscriptions  SellerSubscription[]
  financeAlertsAcked   FinanceAlert[]       @relation("FinanceAlertAck")
  revenueLinesAsSeller RevenueLine[]        @relation("RevenueLineSeller")
  supportTicketsAssigned SupportTicket[]    @relation("SupportAssignee")
  supportTicketNotes   SupportTicketNote[]  @relation("SupportNoteAuthor")
  whitelistEntries     WhitelistEntry[]     @relation("WhitelistUser")
  whitelistCreated     WhitelistEntry[]     @relation("WhitelistCreator")
  warningsReceived     UserWarning[]        @relation("WarnedUser")
  warningsCreated      UserWarning[]        @relation("WarningCreator")
  riskEventsReviewed   RiskEvent[]          @relation("RiskReviewer")
  riskAssessments      RiskAssessment[]
  moderationAppeals    ModerationAppeal[]
  moderationAppealsReviewed ModerationAppeal[] @relation("AppealReviewer")
  consentRecords       ConsentRecord[]
  swapProposals        SwapProposal[]       @relation("SwapProposer")
  giveawayClaims       GiveawayClaim[]      @relation("GiveawayClaimant")
  movingSales          MovingSale[]         @relation("MovingSaleSeller")
  movingSaleFollows    MovingSaleFollow[]
  communityMemberships CommunityMembership[]
  communityInvitesCreated CommunityInvite[] @relation("CommunityInviteCreator")
  communityManagers    CommunityManager[]
  vehicleInspectionsRequested VehicleInspection[] @relation("InspectionRequester")
  luxuryAuthJobsAsBuyer LuxuryAuthJob[] @relation("LuxuryAuthBuyer")
  luxuryAuthJobsAsSeller LuxuryAuthJob[] @relation("LuxuryAuthSeller")
  proAccount           ProAccount?
  bulkUploadJobs       BulkUploadJob[]
  referralCodeOwned    ReferralCode?
  referralsMade        ReferralAttribution[] @relation("ReferralReferrer")
  referralAsReferred   ReferralAttribution?  @relation("ReferralReferred")
  referralRewards      ReferralReward[]
  assistantSessions    AssistantSession[]
  roomScans            RoomScan[]
  savedBundles         SavedBundle[]
  valuations           ValuationLog[]
  consignments         Consignment[]
  managedPickups       ManagedPickup[]
  corporateMemberships CorporateMembership[]
  relocationProjectsOwned RelocationProject[] @relation("RelocationOwner")
  estatePartners       EstatePartner[]
  circularHandoffsAsSeller CircularHandoff[] @relation("CircularHandoffSeller")
  sellerPayoutAccount  SellerPayoutAccount?

  @@map("users")
}

/// Verified seller payout account. Account number stays server-side; clients see a mask.
model SellerPayoutAccount {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  bankCode         String
  bankName         String
  accountNumber    String
  firstName        String
  middleName       String   @default("")
  lastName         String
  nibssAccountName String
  verifiedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_payout_accounts")
}

model Profile {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @db.Uuid
  displayName        String
  /// Public storefront handle (pro sellers); unique when set.
  handle             String? @unique
  fullName           String?
  avatarUrl          String?
  bio                String?
  birthYear          Int?
  preferredCommunity String  @default("")
  language           String  @default("en-NG")
  currency           String  @default("NGN")
  showFullName       Boolean @default(false)
  /// Quiet hours start (inclusive), hour 0–23 in Africa/Lagos (WAT).
  quietHoursStart    Int?
  /// Quiet hours end (exclusive), hour 0–23 WAT. Window may wrap midnight.
  quietHoursEnd      Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Address {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  label     String
  line1     String
  line2     String?
  city      String
  community String
  country   String  @default("NG")
  geoLat    Float?
  geoLng    Float?
  isDefault Boolean @default(false)
  /// Always treat as private PII — never expose in public APIs.
  private   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Verification {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  level           VerificationLevel
  status          VerificationStatus @default(PENDING)
  method          IdentityMethod?
  providerRef     String?
  /// Hash only — never store raw NIN/BVN/gov ID.
  identifierHash  String?
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, level])
  @@map("verifications")
}

model Device {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  name        String
  platform    DevicePlatform @default(UNKNOWN)
  /// Optional client-supplied fingerprint for DEVICE_FINGERPRINT risk rule.
  fingerprint String?
  lastSeenAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  revokedAt   DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([fingerprint])
  @@map("devices")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// Pending email signup. The user row is created only after the code matches.
model EmailSignupOtp {
  email        String   @id
  codeHash     String
  passwordHash String
  displayName  String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("email_signup_otps")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  role      AdminRole
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  parentId  String?  @db.Uuid
  sortOrder Int      @default(0)
  iconUrl   String?
  createdAt DateTime @default(now())

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  listings    Listing[]  @relation("ListingCategory")
  subListings Listing[]  @relation("ListingSubcategory")

  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

model Listing {
  id                 String        @id @default(uuid()) @db.Uuid
  sellerId           String        @db.Uuid
  title              String        @default("")
  description        String        @default("")
  categoryId         String?       @db.Uuid
  subcategoryId      String?       @db.Uuid
  brand              String?
  model              String?
  condition          ItemCondition @default(GOOD)
  ageText            String?
  originalPriceKobo  Int?
  priceKobo          Int           @default(0)
  negotiable         Boolean       @default(true)
  sellingMode        SellingMode   @default(SELL)
  status             ListingStatus @default(DRAFT)
  community          String        @default("")
  communityId        String?       @db.Uuid
  communityOnly      Boolean       @default(false)
  movingSaleId       String?       @db.Uuid
  /// City scope for discovery / comps / alerts (default Lagos).
  city               String        @default("Lagos")
  geoLat             Float?
  geoLng             Float?
  /// Private meetup / pickup address — NEVER expose in public DTOs.
  addressPrivate     String?
  fulfilmentPickup   Boolean       @default(true)
  fulfilmentMeet     Boolean       @default(true)
  fulfilmentDelivery Boolean       @default(false)
  aiUsed             Boolean       @default(false)
  aiEditedFields     String[]      @default([])
  expiresAt          DateTime?
  publishedAt        DateTime?
  views              Int           @default(0)
  vehicle            Json?
  riskFlags          String[]      @default([])
  /// Luxury: require authentication before sale (default true for luxury category).
  authRequired       Boolean       @default(false)
  authenticationStatus AuthenticationStatus @default(NOT_REQUIRED)
  certificateId      String?
  authenticatedAt    DateTime?
  /// If set, schedule circular hand-off when unsold for N days.
  donateIfUnsoldDays Int?
  /// Units the seller listed. Price (`priceKobo`) is per unit.
  quantityTotal      Int           @default(1)
  /// Units buyers can still order. Hidden from the marketplace at 0.
  quantityAvailable  Int           @default(1)
  /// Units held by unpaid orders awaiting confirmation or payment.
  quantityReserved   Int           @default(0)
  /// Units paid for.
  quantitySold       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  seller       User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category?      @relation("ListingCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory  Category?      @relation("ListingSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  estateCommunity Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  movingSale   MovingSale?    @relation(fields: [movingSaleId], references: [id], onDelete: SetNull)
  images       ListingImage[]
  events       ListingEvent[]
  riskEvents   RiskEvent[]
  reports      Report[]
  favourites   Favourite[]
  cartItems    CartItem[]
  conversations Conversation[]
  offers       Offer[]
  orderIntents OrderIntent[]
  orders       Order[]
  listingCards Message[]      @relation("MessageListingCard")
  promotions           Promotion[]
  moderationDecisions  ModerationDecision[]
  listingModerations   ListingModeration[]
  moderationAppeals    ModerationAppeal[]
  riskAssessments      RiskAssessment[]
  swapProposalsAsTarget SwapProposal[] @relation("SwapTargetListing")
  swapProposalsOffered  SwapProposal[] @relation("SwapOfferedListing")
  giveawayClaims        GiveawayClaim[]
  ordersAsSwapA         Order[]        @relation("OrderSwapListingA")
  ordersAsSwapB         Order[]        @relation("OrderSwapListingB")
  vehicleInspections    VehicleInspection[]
  luxuryAuthJobs        LuxuryAuthJob[]
  consignment           Consignment?
  circularHandoffs      CircularHandoff[]
  relocationItems       RelocationItem[]

  @@index([sellerId])
  @@index([status])
  @@index([categoryId])
  @@index([community])
  @@index([communityId])
  @@index([movingSaleId])
  @@index([city])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([authenticationStatus])
  @@index([status, quantityAvailable])
  @@map("listings")
}

model ListingImage {
  id           String             @id @default(uuid()) @db.Uuid
  listingId    String             @db.Uuid
  sortOrder    Int                @default(0)
  originalKey  String
  variants     Json               @default("{}")
  width        Int?
  height       Int?
  mime         String?
  sizeBytes    Int?
  dHash        String?
  exifStripped Boolean            @default(false)
  status       ListingImageStatus @default(PENDING)
  createdAt    DateTime           @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@index([dHash])
  @@index([originalKey])
  @@map("listing_images")
}

model ListingEvent {
  id          String           @id @default(uuid()) @db.Uuid
  listingId   String           @db.Uuid
  type        ListingEventType
  actorUserId String?          @db.Uuid
  payload     Json?
  createdAt   DateTime         @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ListingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([type])
  @@index([createdAt])
  @@map("listing_events")
}

model RiskEvent {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @db.Uuid
  listingId    String?   @db.Uuid
  kind         String
  score        Int?
  detail       Json?
  reviewedAt   DateTime?
  reviewedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("RiskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([userId])
  @@index([kind])
  @@index([reviewedAt])
  @@index([createdAt])
  @@map("risk_events")
}

model Report {
  id             String        @id @default(uuid()) @db.Uuid
  listingId      String?       @db.Uuid
  reportedUserId String?       @db.Uuid
  reporterId     String        @db.Uuid
  reason         String
  detail         String?
  conversationId String?       @db.Uuid
  status         ReportStatus  @default(OPEN)
  /// Set when an admin resolves the report.
  action         ReportAction?
  resolvedById   String?       @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())

  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reportedUser User?         @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reporter     User          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  warnings     UserWarning[]

  @@index([listingId])
  @@index([reportedUserId])
  @@index([reporterId])
  @@index([resolvedById])
  @@index([status])
  @@map("reports")
}

model Favourite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
