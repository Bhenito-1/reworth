  listingId        String?  @db.Uuid
  result           Json
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("valuation_logs")
}

model Consignment {
  id              String            @id @default(uuid()) @db.Uuid
  consignorId     String            @db.Uuid
  listingId       String?           @unique @db.Uuid
  status          ConsignmentStatus @default(INTAKE)
  city            String            @default("Lagos")
  title           String
  floorPriceKobo  Int
  askingPriceKobo Int
  feeBps          Int               @default(1500)
  soldPriceKobo   Int?
  feeKobo         Int?
  netPayoutKobo   Int?
  listedAt        DateTime?
  soldAt          DateTime?
  returnBy        DateTime?
  returnedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  consignor User     @relation(fields: [consignorId], references: [id], onDelete: Cascade)
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([consignorId, status])
  @@index([status, returnBy])
  @@map("consignments")
}

model ManagedPickup {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  city          String              @default("Lagos")
  status        ManagedPickupStatus @default(BOOKED)
  slotStartAt   DateTime
  slotEndAt     DateTime
  addressLine   String
  photoAddon    Boolean             @default(false)
  photoKeys     String[]            @default([])
  partnerRef    String?
  roomScanId    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([slotStartAt])
  @@map("managed_pickups")
}

model CorporateAccount {
  id              String                 @id @default(uuid()) @db.Uuid
  companyName     String
  billingContact  String
  billingEmail    String
  dpaRecordRef    String?
  supportTier     String                 @default("standard")
  status          CorporateAccountStatus @default(APPLIED)
  reviewedById    String?                @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  members  CorporateMembership[]
  projects RelocationProject[]

  @@index([status])
  @@map("corporate_accounts")
}

model CorporateMembership {
  id                 String @id @default(uuid()) @db.Uuid
  corporateAccountId String @db.Uuid
  userId             String @db.Uuid
  role               String @default("COORDINATOR")
  createdAt          DateTime @default(now())

  corporateAccount CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([corporateAccountId, userId])
  @@index([userId])
  @@map("corporate_memberships")
}

model RelocationProject {
  id                 String                   @id @default(uuid()) @db.Uuid
  corporateAccountId String                   @db.Uuid
  ownerUserId        String                   @db.Uuid
  title              String
  employeeName       String
  deadline           DateTime
  cityFrom           String
  cityTo             String
  communityFrom      String                   @default("")
  communityTo        String                   @default("")
  status             RelocationProjectStatus  @default(DRAFT)
  movingSaleId       String?                  @unique @db.Uuid
  completionReport   Json?
  invoiceNumber      String?
  invoicePdfKey      String?
  settledAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  corporateAccount CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  owner            User             @relation("RelocationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  movingSale       MovingSale?      @relation(fields: [movingSaleId], references: [id], onDelete: SetNull)
  items            RelocationItem[]

  @@index([corporateAccountId, status])
  @@index([ownerUserId])
  @@map("relocation_projects")
}

model RelocationItem {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @db.Uuid
  title     String
  notes     String  @default("")
  listingId String? @unique @db.Uuid
  createdAt DateTime @default(now())

  project RelocationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  listing Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("relocation_items")
}

model EstatePartner {
  id           String              @id @default(uuid()) @db.Uuid
  communityId  String              @db.Uuid
  companyName  String
  contactEmail String
  status       EstatePartnerStatus @default(APPLIED)
  apiKeyHash   String?
  apiKeyPrefix String?
  webhookSecret String?
  webhookUrl   String?
  brandingJson Json                @default("{}")
  createdById  String?             @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  community Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  webhookEvents EstatePartnerWebhookEvent[]

  @@index([communityId])
  @@index([status])
  @@index([apiKeyPrefix])
  @@map("estate_partners")
}

model EstatePartnerWebhookEvent {
  id             String   @id @default(uuid()) @db.Uuid
  estatePartnerId String  @db.Uuid
  eventId        String
  eventType      String
  payload        Json
  processedAt    DateTime @default(now())

  partner EstatePartner @relation(fields: [estatePartnerId], references: [id], onDelete: Cascade)

  @@unique([estatePartnerId, eventId])
  @@index([processedAt])
  @@map("estate_partner_webhook_events")
}

model CircularPartner {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  kind               CircularPartnerKind
  city               String              @default("Lagos")
  acceptedCategories String[]            @default([])
  verified           Boolean             @default(false)
  active             Boolean             @default(true)
  contactEmail       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  handoffs CircularHandoff[]

  @@index([city, active])
  @@map("circular_partners")
}

model CircularHandoff {
  id                 String                 @id @default(uuid()) @db.Uuid
  listingId          String                 @db.Uuid
  sellerId           String                 @db.Uuid
  circularPartnerId  String                 @db.Uuid
  status             CircularHandoffStatus  @default(SCHEDULED)
  scheduledAt        DateTime?
  completedAt        DateTime?
  receiptKey         String?
  recipientLabel     String                 @default("")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  listing Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller  User            @relation("CircularHandoffSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  partner CircularPartner @relation(fields: [circularPartnerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([sellerId])
  @@index([status])
  @@map("circular_handoffs")
}

// ─── Phase 3.3 Monetization ─────────────────────────────────────────────────

enum RevenueStream {
  PROTECTION_FEE
  DELIVERY_MARGIN
  BOOST
  FEATURED
  PROMOTED
  SUBSCRIPTION
  INSPECTION_FEE
  AUTHENTICATION_FEE
  CONSIGNMENT_FEE
  OTHER
}

enum RevenueLineStatus {
  PENDING
  SETTLED
  REFUNDED
}

enum SellerPlanTier {
  STARTER
  PLUS
}

enum SellerSubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model FeeConfigVersion {
  id            String   @id @default(uuid()) @db.Uuid
  version       Int      @unique
  /// Snapshot of all monetization price points (kobo / bps / days).
  rates         Json
  effectiveFrom DateTime @default(now())
  createdById   String?  @db.Uuid
  note          String?
  createdAt     DateTime @default(now())

  promotions          Promotion[]
  sellerSubscriptions SellerSubscription[]
  revenueLines        RevenueLine[]

  @@index([effectiveFrom])
  @@map("fee_config_versions")
}

model RevenueLine {
  id               String            @id @default(uuid()) @db.Uuid
  stream           RevenueStream
  grossKobo        Int
  netKobo          Int
  status           RevenueLineStatus @default(PENDING)
  orderId          String?           @db.Uuid
  listingId        String?           @db.Uuid
  sellerId         String?           @db.Uuid
  city             String            @default("Lagos")
  categoryId       String?           @db.Uuid
  pspReference     String?
  /// When true, pspReference may be null until invoiced (admin promoted, etc.).
  deferredPsp      Boolean           @default(false)
  feeConfigVersionId String?         @db.Uuid
  referenceType    String?
  referenceId      String?
  meta             Json              @default("{}")
  createdAt        DateTime          @default(now())
  settledAt        DateTime?
  refundedAt       DateTime?

  seller           User?             @relation("RevenueLineSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  feeConfigVersion FeeConfigVersion? @relation(fields: [feeConfigVersionId], references: [id], onDelete: SetNull)

  @@unique([stream, referenceType, referenceId])
  @@index([stream, createdAt])
  @@index([city, createdAt])
  @@index([status])
  @@index([pspReference])
  @@map("revenue_lines")
}

model SellerSubscription {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @db.Uuid
  tier               SellerPlanTier            @default(STARTER)
  status             SellerSubscriptionStatus  @default(NONE)
  feeConfigVersionId String?                   @db.Uuid
  priceKobo          Int                       @default(0)
  subscriptionRef    String?
  currentPeriodEnd   DateTime?
  graceUntil         DateTime?
  cancelAtPeriodEnd  Boolean                   @default(false)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeConfigVersion FeeConfigVersion? @relation(fields: [feeConfigVersionId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@index([status])
  @@map("seller_subscriptions")
}

model FinanceAlert {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String
  severity    String    @default("warning")
  message     String
  payload     Json      @default("{}")
  resolvedAt  DateTime?
  acknowledgedById String? @db.Uuid
  createdAt   DateTime  @default(now())

  acknowledgedBy User? @relation("FinanceAlertAck", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([resolvedAt, createdAt])
  @@map("finance_alerts")
}

model ReconciliationRun {
  id              String   @id @default(uuid()) @db.Uuid
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  matchedCount    Int      @default(0)
  mismatchCount   Int      @default(0)
  details         Json     @default("{}")

  @@map("reconciliation_runs")
}
