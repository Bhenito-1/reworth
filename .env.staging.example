# Copy to .env.staging at the repo root and fill in real values.
# Git ignores .env.staging. `pnpm dev` never reads this file.
#
# `pnpm staging` loads .env first, then this file overrides the keys you set.
# Production is the same command with .env.production: `pnpm production`.
# Leave a key out to keep the local .env value.

# Render Postgres → External Database URL (not the internal dpg-… host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional. Omit to keep local Redis from .env. With BULLMQ_INLINE=true the
# API still boots if Redis is down.
# REDIS_URL=rediss://USER:PASSWORD@HOST:6379

# Browser apps. Omit these to keep the local API at http://localhost:3001.
# Set them only when the local website should call the deployed Render API.
# Render WEB_ORIGIN must then include http://localhost:3000
# NEXT_PUBLIC_API_URL=https://your-service.onrender.com/api/v1
# NEXT_PUBLIC_WEB_URL=https://your-app.vercel.app
