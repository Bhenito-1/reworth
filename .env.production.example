# Copy to .env.production at the repo root and fill in real values.
# Git ignores .env.production. `pnpm dev` never reads this file.
#
# `pnpm production` loads .env first, then this file overrides the keys you set.
# Leave a key out to keep the local .env value.
# This process writes to the live database. Use it to inspect production, not to seed it.

# Production Postgres external URL (not an internal host that only resolves in the cloud).
DATABASE_URL=postgresql://reworth:ni0ruyCpYSFCJPeX3Kv7wF2CRQqr1Ebw@dpg-db5t0m142hec73a45f00-a.frankfurt-postgres.render.com/reworth

# Optional. Omit to keep local Redis from .env. With BULLMQ_INLINE=true the
# API still boots if Redis is down.
# REDIS_URL=rediss://USER:PASSWORD@HOST:6379

# Browser apps. Omit these to keep the local API at http://localhost:3001.
# Set them only when the local website should call the deployed production API.
# That API's WEB_ORIGIN must then include http://localhost:3000
NEXT_PUBLIC_API_URL=https://reworth-y9gr.onrender.com/api/v1
NEXT_PUBLIC_WEB_URL=https://reworth-livid.vercel.app
