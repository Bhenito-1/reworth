strict-peer-dependencies=false
auto-install-peers=true

# Resilient installs on slow / flaky networks (common with large Next SWC binaries).
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

# Fewer parallel writes — fewer locks on Windows (Desktop/OneDrive/AV).
network-concurrency=4
child-concurrency=2
package-import-method=copy
# Single node_modules tree — more reliable on Windows than isolated per-package links.
node-linker=hoisted
