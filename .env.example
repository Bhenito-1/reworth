# ReWorth local environment — copy to .env at this monorepo root and fill placeholders.
# NEVER commit real secrets. All values below are examples / empty placeholders.
#
# Nest loads this file via ConfigModule (apps/api → ../../.env).
# Prisma CLI does not — use `pnpm db:deploy` / `pnpm --filter @reworth/api run prisma:*`
# (scripts/with-root-env.mjs loads this file and mirrors it to apps/api/.env).

# --- App ---
NODE_ENV=development
APP_NAME=ReWorth
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
# Nest listen port (wins over ambient shell PORT)
API_PORT=3001
# Browser clients (web + admin) — include /api/v1 prefix
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Expo mobile (optional; falls back to localhost)
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
# Public website used in shared product links. Set this to the deployed web
# address (Vercel or similar) before a store or hosted release. Leave empty
# locally: the website uses its own address, and the app uses http://localhost:3000.
NEXT_PUBLIC_WEB_URL=
EXPO_PUBLIC_WEB_URL=
ADMIN_URL=http://localhost:3002
# NGN / en-NG / Africa/Lagos (WAT)
DEFAULT_CURRENCY=NGN
DEFAULT_LOCALE=en-NG
DEFAULT_TIMEZONE=Africa/Lagos

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://reworth:reworth@localhost:5432/reworth?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# Process media jobs inline (no Redis required). Default true in test.
BULLMQ_INLINE=true

# --- Object storage (adobe/s3mock locally) ---
# STORAGE_DRIVER=s3 → S3StorageAdapter at S3_ENDPOINT (compose service s3mock on :9000).
# STORAGE_DRIVER=local|fs → API disk fallback.
STORAGE_DRIVER=s3
MEDIA_LOCAL_DIR=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=reworth
S3_SECRET_ACCESS_KEY=reworthsecret
S3_BUCKET=reworth-media
S3_FORCE_PATH_STYLE=true
# Public object URLs (path-style): http://localhost:9000/{bucket}/{key}
S3_PUBLIC_URL=http://localhost:9000/reworth-media
# mock = variant URLs alias original; sharp = real derivatives when available
MEDIA_PIPELINE=mock
LISTING_EXPIRY_DAYS=60
# Phase 4 — offers + listing reserve on accept
OFFER_EXPIRY_HOURS=24
LISTING_RESERVE_HOURS=1
# Phase 2.1 — swap + give-away
SWAP_PROPOSAL_EXPIRY_HOURS=72
GIVEAWAY_CLAIM_EXPIRY_HOURS=72
SWAP_EXPIRY_SCHEDULER=true
GEOCODING_PROVIDER=mock
# Phase 2.2 — communities + moving sales
COMMUNITY_INVITE_EXPIRY_DAYS=7
MOVING_SALE_EXPIRY_SCHEDULER=true

# Phase 2.3 — Intelligence
SAVED_SEARCH_ALERT_INTERVAL_MS=900000
VALUATION_MIN_SAMPLES=5
INTELLIGENCE_CITY_DEFAULT=Lagos

# --- OpenSearch / Discovery search ---
OPENSEARCH_NODE=http://localhost:9200
# postgres (default) | opensearch
SEARCH_PROVIDER=postgres
# Set true to prefer Postgres FTS even if OpenSearch is up / unavailable
SEARCH_USE_POSTGRES_FTS_FALLBACK=true
# Home rails Redis cache TTL (seconds); falls back to in-memory
HOME_CACHE_TTL_SECONDS=45

# --- Auth / JWT ---
# Generate strong random values for local use; do not reuse in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# Consumer access token — 24h default keeps mobile sessions usable; refresh rotates at 30d
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=30d
# Pepper for refresh-token + identity identifier hashing (never reuse production value)
OTP_PEPPER=change-me-otp-pepper-min-32-chars

# --- Admin bootstrap ---
ADMIN_SUPER_EMAIL=admin@example.com
ADMIN_SUPER_PASSWORD=change-me-strong-password
# Optional: seed Super Admin on API boot (prefer prisma db seed)
ADMIN_SEED_ON_BOOT=false
# TOTP issuer label for admin 2FA shell (Phase 1+)
ADMIN_TOTP_ISSUER=ReWorth

# --- Identity verification ---
IDENTITY_PROVIDER=mock


# --- Email ---
# mock | mailhog | resend
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# Must use a domain verified in Resend (SPF + DKIM + DMARC). Avoid no-reply@.
EMAIL_FROM=ReWorth <hello@your-verified-domain.com>
EMAIL_REPLY_TO=hello@your-verified-domain.com
# Public https URL used in email CTAs. Never localhost — that sends mail to spam.
EMAIL_APP_URL=https://your-app-host.example
# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# --- Push notifications ---
# mock (logs); Expo/FCM later
PUSH_PROVIDER=mock
# mock | expo — ExpoPushProvider posts to exp.host when PUSH_PROVIDER=expo
ENABLE_PUSH=false
# Optional Expo access token for push API rate limits
EXPO_ACCESS_TOKEN=
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# FCM later
FCM_SERVER_KEY=

# --- Delivery / logistics ---
# mock (deterministic quote + status)
DELIVERY_PROVIDER=mock

# --- Payments (Paystack) ---
PAYMENTS_PROVIDER=mock
# paystack calls GET /bank/resolve. mock uses GTBank 0123456789 → Adewale Chinedu Okonkwo.
# A sk_test_ secret is for local checks only. Never use it in production.
ACCOUNT_NAME_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Phase 5 — buyer protection / escrow
BUYER_PROTECTION_FEE_PCT=0.025
BUYER_PROTECTION_FEE_CAP_KOBO=500000
ORDER_AUTO_RELEASE_DAYS=3
BUYER_PROTECTION_COVERAGE_DAYS=7
# Set false to disable schedulers locally if needed
# ORDER_AUTO_RELEASE_SCHEDULER=false
# DISPUTE_SELLER_EXPIRY_SCHEDULER=false
# TRUST_SCORE_CRON=false

# --- Phase 2.4 Verticals & Commercial ---
INSPECTION_FEE_KOBO=2500000
AUTH_FEE_KOBO=1500000
PRO_SUBSCRIPTION_KOBO=1500000
INSPECTION_VALIDITY_DAYS=30
PRO_GRACE_DAYS=7
BULK_UPLOAD_MAX_ROWS=50
INSPECTION_PROVIDER=mock
AUTHENTICATION_PROVIDER=mock
# INSPECTION_EXPIRY_SCHEDULER=false
# PRO_SUBSCRIPTION_SCHEDULER=false

# --- AI ---
# mock = rule-based offline drafts (default, CI-safe)
# openai = GPT-4o listing assist + vision when OPENAI_API_KEY is set
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional Azure / proxy base (default https://api.openai.com/v1)
# OPENAI_BASE_URL=

# --- Phase 3.1 AI & Platform Services ---
ASSISTANT_PROVIDER=mock
CONSIGNMENT_FEE_BPS=1500
CONSIGNMENT_RETURN_DAYS=30
ROOM_SCAN_MAX_PHOTOS=8
# ASSISTANT_SCHEDULER=false
# CONSIGNMENT_EXPIRY_SCHEDULER=false

# --- Phase 3.2 B2B & Expansion ---
# Absolute or relative path to config/regions (default: monorepo config/regions)
REGION_CONFIG_DIR=
# Consumer pilot cities (comma-separated keys). Default: SW + Abuja + PH from config status=pilot
# REGION_PILOT_CITIES=lagos,ogun,ibadan,osun,ondo,ekiti,edo,abuja,port-harcourt,kano
# CIRCULAR_DONATE_SCHEDULER=false

# --- Moderation (Phase 9) ---
# mock | (NSFW prod adapter deferred). Image-title checks use the vision module.
IMAGE_MODERATION_PROVIDER=mock

# --- Vision (Roboflow Image-Title Check). Server-side only; never send to clients. ---
ROBOFLOW_API_KEY=
# ROBOFLOW_WORKSPACE=reworth-pm12p
# ROBOFLOW_WORKFLOW_ID=reworth-image-title-check-1790810818816
# ROBOFLOW_API_BASE_URL=https://serverless.roboflow.com
# VISION_TIMEOUT_MS=25000
# VISION_LOW_CONFIDENCE_THRESHOLD=0.5
# VISION_MAX_IMAGES=4

# --- Risk thresholds override via RiskRule code THRESHOLDS in DB (medium:40, high:70) ---

# --- Security / load test ---
WEB_ORIGIN=http://localhost:3000,http://localhost:3003
ADMIN_ORIGIN=http://localhost:3002
# Expo web previews (local)
MOBILE_WEB_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083
# Set to 1 only for k6 / staging load tests — never in production
DISABLE_THROTTLE=

# --- OAuth ---
# Live Google/Apple secrets optional. When unset, POST /auth/oauth/:provider/callback
# uses the mock adapter (deterministic emails below). Consumer UIs call the same route.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/apple/callback
OAUTH_MOCK_GOOGLE_EMAIL=google.user@example.com
OAUTH_MOCK_GOOGLE_NAME=Google User
OAUTH_MOCK_APPLE_EMAIL=apple.user@example.com
OAUTH_MOCK_APPLE_NAME=Apple User

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# --- Feature flags / misc ---
# (push/delivery providers above)

# --- Phase 10 staging seed ---
# SEED_STAGING_SKIP_HEAVY=1 → demo accounts + 50 listings only (fast local)
# SEED_STAGING_SKIP_HEAVY=

# --- Playwright e2e (demo passwords — never production secrets) ---
# API_BASE_URL=http://localhost:3001/api/v1
# WEB_BASE_URL=http://localhost:3000
# E2E_SELLER_PHONE=+2348010000001
# E2E_SELLER_EMAIL=ori@demo.reworth.ng
# E2E_SELLER_PASSWORD=DemoOri!2026
# E2E_BUYER_EMAIL=ayo@demo.reworth.ng
# E2E_BUYER_PASSWORD=DemoAyo!2026
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=change-me-strong-password
