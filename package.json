{
  "name": "reworth",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@reworth/api --filter=@reworth/web --filter=@reworth/admin",
    "db:deploy:staging": "dotenv -e .env.staging -- pnpm db:deploy",
    "db:deploy:prod": "dotenv -e .env.production -- pnpm db:deploy",
    "build:staging": "dotenv -e .env.staging -- turbo run build",
    "build:prod": "dotenv -e .env.production -- turbo run build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "audit:prod": "pnpm audit --prod --audit-level=critical",
    "seed:staging": "pnpm --filter @reworth/api seed:staging",
    "test:e2e": "playwright test",
    "validate:cities": "node scripts/validate-city-config.mjs",
    "db:generate": "pnpm --filter @reworth/api run prisma:generate",
    "db:migrate": "pnpm --filter @reworth/api run prisma:migrate",
    "db:deploy": "pnpm --filter @reworth/api run prisma:deploy",
    "db:seed": "pnpm --filter @reworth/api run prisma:seed",
    "db:studio": "pnpm --filter @reworth/api run prisma:studio"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "tar": "^7.5.19",
      "proxy-addr": ">=2.0.8",
      "shell-quote": "1.11.0",
      "next": "15.5.28"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "2.10.12",
    "typescript": "^5.9.3"
  }
}
